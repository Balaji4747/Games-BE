{
  "name": "provfair",
  "version": "0.0.1",
  "description": "",
  "author": "Arghya Chanda<arghyac35@gmail.com>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start-all": "pm2 start ecosystem.config.js",
    "restart-all": "node ./restart-all.js",
    "start": "concurrently \"SERVICE=players nest start players\" \"SERVICE=aviatorx nest start aviatorx\" \"SERVICE=gateway-ws nest start gateway-ws\" \"SERVICE=management nest start management\"",
    "start:dev": "concurrently \"SERVICE=players nest start players --watch\" \"SERVICE=aviatorx nest start aviatorx --watch\" \"SERVICE=gateway-ws nest start gateway-ws --watch\" \"SERVICE=management nest start management --watch\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/players/main",
    "start:players": "SERVICE=players nest start players",
    "start:federation": "SERVICE=federation nest start federation",
    "start:gateway-ws": "SERVICE=gateway-ws nest start gateway-ws",
    "start:aviatorx": "SERVICE=aviatorx nest start aviatorx",
    "start:crash": "SERVICE=crash nest start crash",
    "start:slide": "SERVICE=slide nest start slide",
    "start:dice": "SERVICE=dice nest start dice",
    "start:plinko": "SERVICE=plinko nest start plinko",
    "start:limbo": "SERVICE=limbo nest start limbo",
    "start:diamonds": "SERVICE=diamonds nest start diamonds",
    "start:hilo": "SERVICE=hilo nest start hilo",
    "start:mines": "SERVICE=mines nest start mines",
    "start:management": "SERVICE=management nest start management",
    "start:commander": "SERVICE=commander nest start commander",
    "start:pcrash": "SERVICE=pcrash nest start pcrash",
    "start:buttonpop": "SERVICE=buttonpop nest start buttonpop",
    "start:bottlesmash": "SERVICE=bottlesmash nest start bottlesmash",
    "start:overandout": "SERVICE=overandout nest start overandout",
    "lint": "NODE_OPTIONS=\"--max_old_space_size=6096\" eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "yarn run lint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/players/test/jest-e2e.json",
    "prepare": "husky",
    "gen": "FEDERATION_URL=http://localhost:3100/graphql graphql-codegen --config libs/modules/federation-client/codegen.ts"
  },
  "dependencies": {
    "@apollo/gateway": "^2.8.4",
    "@apollo/server": "^4.10.5",
    "@apollo/subgraph": "^2.8.4",
    "@nestjs/apollo": "^12.2.0",
    "@nestjs/axios": "^3.0.2",
    "@nestjs/bullmq": "^10.2.0",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.2.0",
    "@nestjs/microservices": "^10.4.1",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/websockets": "^10.3.10",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "@types/json-schema": "^7.0.15",
    "ajv": "^8.17.1",
    "axios": "^1.7.2",
    "bullmq": "^5.12.5",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "env-var": "^7.5.0",
    "graphql": "^16.9.0",
    "graphql-query-complexity": "^1.0.0",
    "graphql-request": "6.1.0",
    "graphql-scalars": "^1.23.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.4.1",
    "json-schema": "^0.4.0",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^13.2.0",
    "mongoose": "^8.5.1",
    "nanoid": "3.3.7",
    "nest-commander": "^3.15.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "redlock": "5.0.0-beta.2",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.7.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-graphql-request": "^6.2.0",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^9.1.3",
    "jest": "^29.5.0",
    "lint-staged": "^15.2.7",
    "prettier": "^3.0.0",
    "prettier-plugin-organize-imports": "^4.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "wait-on": "^8.0.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "node ./commit-msg.js"
    }
  },
  "lint-staged": {
    "apps/**/src/**/*{.ts,.json}": [
      "prettier --write",
      "node --max_old_space_size=6096 ./node_modules/eslint/bin/eslint.js --fix"
    ]
  },
  "packageManager": "yarn@4.3.1"
}
