  "version": "0.2.0",
  "configurations": [
    {
      "name": "mines-sim",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceRoot}/node_modules/.bin/ts-node-dev",
      "restart": true,
      "runtimeArgs": ["-r", "tsconfig-paths/register", "--respawn"],
      "args": ["apps/commander/src/main.ts", "minesSim"],
      "cwd": "${workspaceRoot}",
      "internalConsoleOptions": "openOnSessionStart",
      "sourceMaps": true,
      "console": "internalConsole",
      "outputCapture": "std",
      "env": { "SERVICE": "commander" }
    },
    {
